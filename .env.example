# FastF1 cache directory (default: ./cache/fastf1)
FASTF1_CACHE_DIR=./cache/fastf1

# API base URLs (defaults shown)
OPENF1_API_BASE=https://api.openf1.org/v1
JOLPICA_API_BASE=https://api.jolpi.ca/ergast/f1

# News refresh interval in minutes (default: 15)
NEWS_REFRESH_INTERVAL_MINS=15

# Database path (default: ./f1_data.db)
DATABASE_URL=sqlite:///./f1_data.db
